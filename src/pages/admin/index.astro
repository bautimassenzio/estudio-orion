      // =======================================================================
      async function cargarDatos() {
        if (isMockMode) {
          negociosList = [...MOCK_NEGOCIOS];
          pagosList = [...MOCK_PAGOS];
          eventosList = [...MOCK_EVENTOS];
          renderSuperAdmin();
          return;
        }

        if (!SUPABASE_URL || !SUPABASE_KEY) return;

        try {
          if (isSuperAdmin) {
            const [negRes, pagRes] = await Promise.all([
              fetch(`${SUPABASE_URL}/rest/v1/negocios?select=*&order=created_at.desc`, { headers: sbHeaders() }),
              fetch(`${SUPABASE_URL}/rest/v1/pagos?select=*&order=fecha_pago.desc`, { headers: sbHeaders() }),
            ]);
            negociosList = negRes.ok ? await negRes.json() : [];
            pagosList = pagRes.ok ? await pagRes.json() : [];
            renderSuperAdmin();
          } else {
            // Buscar el negocio asociado al usuario logueado
            const negRes = await fetch(
              `${SUPABASE_URL}/rest/v1/negocios?or=(user_id.eq.${currentUserId},email_cliente.eq.${encodeURIComponent(currentUserEmail)})&select=*`,
              { headers: sbHeaders() }
            );
            const rows = negRes.ok ? await negRes.json() : [];
            if (rows.length > 0) {
              openClientView(rows[0]);
            } else {
              showToast('No se encontró un negocio asociado a este correo.');
            }
          }
        } catch {
          showToast('Error al conectar con Supabase.');
        }
      }

