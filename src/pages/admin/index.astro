      // Guardar Configuración en Vista Cliente
      document.getElementById('form-client-config')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!selectedClientNegocio) return;

        const saveBtn = document.getElementById('btn-save-client-config') as HTMLButtonElement | null;
        const saveSpinner = document.getElementById('cfg-save-spinner');
        const saveText = document.getElementById('cfg-save-btn-text');
        if (saveBtn) saveBtn.disabled = true;
        saveSpinner?.classList.remove('hidden');
        if (saveText) saveText.textContent = 'Guardando...';

        const updates = {
          banner_activo: (document.getElementById('cfg-banner-activo') as HTMLInputElement).checked,
          banner_texto: (document.getElementById('cfg-banner-texto') as HTMLInputElement).value.trim(),
          whatsapp: (document.getElementById('cfg-whatsapp') as HTMLInputElement).value.trim(),
          email_contacto: (document.getElementById('cfg-email') as HTMLInputElement).value.trim(),
          mensaje_wpp_default: (document.getElementById('cfg-mensaje-wpp') as HTMLInputElement).value.trim(),
          direccion: (document.getElementById('cfg-direccion') as HTMLInputElement).value.trim(),
          horarios: (document.getElementById('cfg-horarios') as HTMLTextAreaElement).value.trim(),
          instagram_url: (document.getElementById('cfg-instagram') as HTMLInputElement).value.trim(),
          facebook_url: (document.getElementById('cfg-facebook') as HTMLInputElement).value.trim(),
          tiktok_url: (document.getElementById('cfg-tiktok') as HTMLInputElement).value.trim(),
        };

        Object.assign(selectedClientNegocio, updates);

        try {
          if (!isMockMode && SUPABASE_URL) {
            await fetch(
              `${SUPABASE_URL}/rest/v1/negocios?id=eq.${encodeURIComponent(selectedClientNegocio.id)}`,
              {
                method: 'PATCH',
                headers: sbHeaders(),
                body: JSON.stringify(updates),
              }
            );
          }
          const fb = document.getElementById('cfg-save-feedback');
          fb?.classList.remove('hidden');
          setTimeout(() => fb?.classList.add('hidden'), 3000);
          showToast('Datos actualizados correctamente en el sitio web');
        } finally {
          if (saveBtn) saveBtn.disabled = false;
          saveSpinner?.classList.add('hidden');
          if (saveText) saveText.textContent = 'Guardar Cambios';
        }
      });

      // Restaurar sesión activa automáticamente si el usuario recarga la página
      if (accessToken && currentUserEmail) {
        if (!SUPERADMIN_EMAIL || currentUserEmail === SUPERADMIN_EMAIL) {
          entrarComoSuperAdmin(false);
        } else {
          isMockMode = false;
          isSuperAdmin = false;
          (document.getElementById('topbar-role-badge') as HTMLElement).textContent = 'Panel de Administración';
          (document.getElementById('topbar-user-email') as HTMLElement).textContent = currentUserEmail;
          cargarDatos();
        }
      }

      // Modal Configurar Supabase Localmente
      const modalConn = document.getElementById('modal-conn');
      document.getElementById('btn-open-conn-modal')?.addEventListener('click', () => {
        (document.getElementById('conn-url') as HTMLInputElement).value = SUPABASE_URL;
        (document.getElementById('conn-key') as HTMLInputElement).value = SUPABASE_KEY;
        (document.getElementById('conn-email') as HTMLInputElement).value = SUPERADMIN_EMAIL;
        modalConn?.classList.remove('hidden');
      });
      document.getElementById('btn-close-conn-modal')?.addEventListener('click', () => modalConn?.classList.add('hidden'));
      document.getElementById('btn-save-conn')?.addEventListener('click', () => {
        SUPABASE_URL = (document.getElementById('conn-url') as HTMLInputElement).value.trim();
        SUPABASE_KEY = (document.getElementById('conn-key') as HTMLInputElement).value.trim();
        SUPERADMIN_EMAIL = (document.getElementById('conn-email') as HTMLInputElement).value.trim().toLowerCase();
        localStorage.setItem('orion_sb_url', SUPABASE_URL);
        localStorage.setItem('orion_sb_key', SUPABASE_KEY);
        localStorage.setItem('orion_sb_admin', SUPERADMIN_EMAIL);
        modalConn?.classList.add('hidden');
        showToast('Conexión de Supabase guardada en el navegador');
      });
    </script>
  </body>
</html>
