          proximo_vencimiento_pago: new Date(Date.now() + 8 * 86400000).toISOString().slice(0, 10),
          visitas_demo: 6,
          ultima_visita_demo: new Date(Date.now() - 2 * 86400000).toISOString(),
          whatsapp: '5492215550199',
          mensaje_wpp_default: 'Hola! Vi su página web y me gustaría solicitar un turno.',
          email_contacto: 'turnos@clinicanova.com.ar',
          direccion: 'Av. 7 N° 842, Piso 4, La Plata',
          horarios: 'Lunes a Viernes: 09:00 a 20:00 hs\nSábados: 09:00 a 13:30 hs',
