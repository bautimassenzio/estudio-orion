      // =======================================================================
      // RENDERIZADO VISTA CLIENTE (ESTADÍSTICAS UTM + CONFIG)
      // =======================================================================
      async function openClientView(negocio: Record<string, any>) {
        selectedClientNegocio = negocio;
        document.getElementById('view-login')?.classList.add('hidden');
        document.getElementById('view-superadmin')?.classList.add('hidden');
        document.getElementById('admin-topbar')?.classList.remove('hidden');
        document.getElementById('view-cliente')?.classList.remove('hidden');

        const backBtn = document.getElementById('btn-back-to-crm');
        if (backBtn) {
          backBtn.classList.toggle('hidden', !isSuperAdmin);
        }

        (document.getElementById('client-header-name') as HTMLElement).textContent = negocio.nombre;

        // Cargar eventos de este negocio
        let evs = eventosList.filter((e) => e.negocio_id === negocio.id);
        if (!isMockMode && SUPABASE_URL && SUPABASE_KEY) {
          try {
            const res = await fetch(
              `${SUPABASE_URL}/rest/v1/eventos_conversion?negocio_id=eq.${encodeURIComponent(negocio.id)}&order=created_at.desc&limit=500`,
              { headers: sbHeaders() }
            );
            if (res.ok) {
              evs = await res.json();
            }
          } catch {
            // fallback
          }
        }

        const vistas = evs.filter((e) => e.tipo === 'vista_pagina');
        const clicsWpp = evs.filter((e) => e.tipo === 'click_whatsapp' || e.tipo === 'formulario_whatsapp');
        const totalVistas = Math.max(vistas.length, clicsWpp.length);
        const convRate = totalVistas > 0 ? Math.round((clicsWpp.length / totalVistas) * 100) : 0;

        (document.getElementById('client-kpi-visits') as HTMLElement).textContent = String(totalVistas);
        (document.getElementById('client-kpi-wpp') as HTMLElement).textContent = String(clicsWpp.length);
        (document.getElementById('client-kpi-conv') as HTMLElement).textContent = `${convRate}%`;

        // Agrupar orígenes (Instagram, Google, Facebook, TikTok, Directo)
        const origenesMap: Record<string, { vistas: number; clics: number }> = {
          Instagram: { vistas: 0, clics: 0 },
          Google: { vistas: 0, clics: 0 },
          Facebook: { vistas: 0, clics: 0 },
          Directo: { vistas: 0, clics: 0 },
        };

        evs.forEach((ev) => {
          const org = ev.origen || 'Directo';
          if (!origenesMap[org]) origenesMap[org] = { vistas: 0, clics: 0 };
          if (ev.tipo === 'vista_pagina') {
            origenesMap[org].vistas += 1;
          } else {
            origenesMap[org].clics += 1;
          }
        });

        const barsContainer = document.getElementById('client-origins-bars');
        if (barsContainer) {
          const entries = Object.entries(origenesMap).sort((a, b) => b[1].vistas + b[1].clics - (a[1].vistas + a[1].clics));
          barsContainer.innerHTML = entries
            .map(([origen, counts]) => {
              const pct = totalVistas > 0 ? Math.min(100, Math.round((Math.max(counts.vistas, counts.clics) / totalVistas) * 100)) : 0;
              return `
                <div>
                  <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-bold text-white">${origen}</span>
                    <span class="text-zinc-400">${Math.max(counts.vistas, counts.clics)} visitas · <strong class="text-emerald-400">${counts.clics} clics a WhatsApp</strong> (${pct}%)</span>
                  </div>
                  <div class="w-full h-2.5 rounded-full bg-zinc-800 overflow-hidden">
                    <div class="h-full rounded-full bg-gradient-to-r from-violet-600 to-emerald-400" style="width: ${Math.max(pct, 4)}%"></div>
                  </div>
                </div>
              `;
            })
            .join('');
        }

        // Lista de últimos clics a WhatsApp
        const recentEl = document.getElementById('client-recent-events');
        if (recentEl) {
          if (clicsWpp.length === 0) {
            recentEl.innerHTML = `<p class="text-xs text-zinc-500 py-4">Aún no hay clics registrados.</p>`;
          } else {
            recentEl.innerHTML = clicsWpp
              .slice(0, 12)
              .map((ev) => {
                const fecha = ev.created_at
                  ? new Date(ev.created_at).toLocaleString('es-AR', {
                      day: '2-digit',
                      month: '2-digit',
                      hour: '2-digit',
                      minute: '2-digit',
                    })
                  : '';
                return `
                  <div class="rounded-xl border border-zinc-800/80 bg-zinc-950/60 p-3 flex items-start justify-between gap-3">
                    <div>
                      <span class="inline-block rounded-md bg-emerald-500/15 text-emerald-300 px-2 py-0.5 text-[11px] font-bold">
                        Desde ${ev.origen || 'Directo'}
                      </span>
                      <p class="text-xs text-zinc-200 font-medium mt-1">${ev.detalle || 'Clic en botón de WhatsApp'}</p>
                    </div>
                    <span class="text-[11px] text-zinc-500 shrink-0">${fecha}</span>
                  </div>
                `;
              })
              .join('');
          }
        }

        // Rellenar formulario de configuración del cliente
        (document.getElementById('cfg-banner-activo') as HTMLInputElement).checked = Boolean(negocio.banner_activo);
        (document.getElementById('cfg-banner-texto') as HTMLInputElement).value = negocio.banner_texto || '';
        (document.getElementById('cfg-whatsapp') as HTMLInputElement).value = negocio.whatsapp || '';
        (document.getElementById('cfg-email') as HTMLInputElement).value = negocio.email_contacto || '';
        (document.getElementById('cfg-mensaje-wpp') as HTMLInputElement).value = negocio.mensaje_wpp_default || '';
        (document.getElementById('cfg-direccion') as HTMLInputElement).value = negocio.direccion || '';
        (document.getElementById('cfg-horarios') as HTMLTextAreaElement).value = negocio.horarios || '';
        (document.getElementById('cfg-instagram') as HTMLInputElement).value = negocio.instagram_url || '';
        (document.getElementById('cfg-facebook') as HTMLInputElement).value = negocio.facebook_url || '';
        (document.getElementById('cfg-tiktok') as HTMLInputElement).value = negocio.tiktok_url || '';
      }

