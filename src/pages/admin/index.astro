      function setLoginLoading(loading: boolean) {
        const btn = document.getElementById('btn-login-submit') as HTMLButtonElement | null;
        const spinner = document.getElementById('login-spinner');
        const txt = document.getElementById('login-btn-text');
        if (btn) btn.disabled = loading;
        spinner?.classList.toggle('hidden', !loading);
        if (txt) txt.textContent = loading ? 'Iniciando sesión...' : 'Iniciar Sesión';
      }

      // Login real con Supabase Auth
      document.getElementById('form-login')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const errEl = document.getElementById('login-error') as HTMLElement;
        errEl.classList.add('hidden');

        const email = (document.getElementById('login-email') as HTMLInputElement).value.trim().toLowerCase();
        const password = (document.getElementById('login-password') as HTMLInputElement).value;

        if (!SUPABASE_URL || !SUPABASE_KEY) {
          errEl.textContent = 'Las credenciales de conexión no están disponibles.';
          errEl.classList.remove('hidden');
          return;
        }

        setLoginLoading(true);

        try {
          const res = await fetch(`${SUPABASE_URL}/auth/v1/token?grant_type=password`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_KEY,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ email, password }),
          });
          const data = await res.json();
          if (!res.ok) {
            errEl.textContent = data.error_description || data.msg || 'Correo o contraseña incorrectos.';
            errEl.classList.remove('hidden');
            setLoginLoading(false);
            return;
          }

          accessToken = data.access_token;
          currentUserEmail = (data.user?.email || email).toLowerCase();
          currentUserId = data.user?.id || '';
          sessionStorage.setItem('orion_access_token', accessToken);
          sessionStorage.setItem('orion_user_email', currentUserEmail);
          sessionStorage.setItem('orion_user_id', currentUserId);

          if (!SUPERADMIN_EMAIL || currentUserEmail === SUPERADMIN_EMAIL) {
            entrarComoSuperAdmin(false);
          } else {
            isMockMode = false;
            isSuperAdmin = false;
            (document.getElementById('topbar-role-badge') as HTMLElement).textContent = 'Panel de Administración';
            (document.getElementById('topbar-user-email') as HTMLElement).textContent = currentUserEmail;
            await cargarDatos();
          }
        } catch {
          errEl.textContent = 'No se pudo conectar con el servidor de autenticación.';
          errEl.classList.remove('hidden');
        } finally {
          setLoginLoading(false);
        }
      });

      // Tabs SuperAdmin (Negocios vs Pagos)
