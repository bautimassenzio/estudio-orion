      document.getElementById('crm-tbody-pagos')?.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('button[data-action="delete-pago"]') as HTMLButtonElement | null;
        if (!btn) return;
        const id = btn.dataset.id;
        pagosList = pagosList.filter((p) => String(p.id) !== String(id));
        if (!isMockMode && SUPABASE_URL && id) {
          await fetch(`${SUPABASE_URL}/rest/v1/pagos?id=eq.${encodeURIComponent(id)}`, {
            method: 'DELETE',
            headers: sbHeaders(),
          });
        }
