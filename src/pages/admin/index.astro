      // Modal Cliente (Crear / Editar)
      const modalClient = document.getElementById('modal-client');
      const selectModalidad = document.getElementById('mc-modalidad') as HTMLSelectElement;

      function toggleModalidadBoxes() {
        const val = selectModalidad.value;
        document.getElementById('mc-box-mensual')?.classList.toggle('hidden', val !== 'mensual');
        const boxUnico = document.getElementById('mc-box-unico');
        if (boxUnico) {
          boxUnico.classList.toggle('hidden', val !== 'pago_unico');
          boxUnico.classList.toggle('grid', val === 'pago_unico');
        }
      }
      selectModalidad?.addEventListener('change', toggleModalidadBoxes);

      function abrirModalCliente(negocio?: Record<string, any>) {
        const isEdit = Boolean(negocio);
        (document.getElementById('mc-is-edit') as HTMLInputElement).value = String(isEdit);
        (document.getElementById('modal-client-title') as HTMLElement).textContent = isEdit
          ? `Editar: ${negocio?.nombre}`
          : 'Nuevo Cliente / Demo';

        const idInput = document.getElementById('mc-id') as HTMLInputElement;
        idInput.value = negocio?.id || '';
        idInput.readOnly = isEdit;

        (document.getElementById('mc-nombre') as HTMLInputElement).value = negocio?.nombre || '';
        (document.getElementById('mc-estado') as HTMLSelectElement).value = negocio?.estado || 'demo';
        selectModalidad.value = negocio?.modalidad_cobro || 'mensual';
        (document.getElementById('mc-precio-mensual') as HTMLInputElement).value = String(
          negocio?.precio_mensual ?? 35000
        );
        (document.getElementById('mc-vencimiento') as HTMLInputElement).value =
          negocio?.proximo_vencimiento_pago || '';
        (document.getElementById('mc-monto-unico') as HTMLInputElement).value = String(
          negocio?.monto_unico ?? 150000
        );
        (document.getElementById('mc-estado-unico') as HTMLSelectElement).value =
          negocio?.estado_pago_unico || 'pendiente';
        (document.getElementById('mc-whatsapp') as HTMLInputElement).value = negocio?.whatsapp || '';
        (document.getElementById('mc-url') as HTMLInputElement).value = negocio?.url_sitio || '';
        (document.getElementById('mc-email-cliente') as HTMLInputElement).value = negocio?.email_cliente || '';
        (document.getElementById('mc-password-cliente') as HTMLInputElement).value = '';
        (document.getElementById('mc-acceso-panel') as HTMLInputElement).checked =
          negocio?.acceso_panel !== false;
        (document.getElementById('mc-barra-demo') as HTMLInputElement).checked =
          negocio?.mostrar_barra_demo !== false;

        toggleModalidadBoxes();
        modalClient?.classList.remove('hidden');
      }

      document.getElementById('btn-open-new-client')?.addEventListener('click', () => abrirModalCliente());
      document.getElementById('btn-close-client-modal')?.addEventListener('click', () => modalClient?.classList.add('hidden'));
      document.getElementById('btn-cancel-client-modal')?.addEventListener('click', () => modalClient?.classList.add('hidden'));

      document.getElementById('form-modal-client')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const isEdit = (document.getElementById('mc-is-edit') as HTMLInputElement).value === 'true';
        const id = (document.getElementById('mc-id') as HTMLInputElement).value
          .trim()
          .toLowerCase()
          .replace(/[^a-z0-9-]/g, '-');

        const emailCliente = (document.getElementById('mc-email-cliente') as HTMLInputElement).value
          .trim()
          .toLowerCase();
        const passwordCliente = (document.getElementById('mc-password-cliente') as HTMLInputElement).value.trim();

        let createdUserId: string | null = null;
        if (!isMockMode && SUPABASE_URL && emailCliente && passwordCliente) {
          try {
            const signUpRes = await fetch(`${SUPABASE_URL}/auth/v1/signup`, {
              method: 'POST',
              headers: {
                apikey: SUPABASE_KEY,
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ email: emailCliente, password: passwordCliente }),
            });
            if (signUpRes.ok) {
              const signUpData = await signUpRes.json();
              createdUserId = signUpData?.user?.id || signUpData?.id || null;
            }
          } catch {
            // continúa guardando la ficha
          }
        }

        const payload: Record<string, any> = {
          id,
          nombre: (document.getElementById('mc-nombre') as HTMLInputElement).value.trim(),
          estado: (document.getElementById('mc-estado') as HTMLSelectElement).value,
          modalidad_cobro: selectModalidad.value,
          precio_mensual: Number((document.getElementById('mc-precio-mensual') as HTMLInputElement).value || 0),
          proximo_vencimiento_pago:
            (document.getElementById('mc-vencimiento') as HTMLInputElement).value || null,
          monto_unico: Number((document.getElementById('mc-monto-unico') as HTMLInputElement).value || 0),
          estado_pago_unico: (document.getElementById('mc-estado-unico') as HTMLSelectElement).value,
          whatsapp: (document.getElementById('mc-whatsapp') as HTMLInputElement).value.trim(),
          url_sitio: (document.getElementById('mc-url') as HTMLInputElement).value.trim(),
          email_cliente: emailCliente,
          acceso_panel: (document.getElementById('mc-acceso-panel') as HTMLInputElement).checked,
          mostrar_barra_demo: (document.getElementById('mc-barra-demo') as HTMLInputElement).checked,
        };
        if (createdUserId) {
          payload.user_id = createdUserId;
        }

        if (isMockMode) {
          const idx = negociosList.findIndex((n) => n.id === id);
          if (idx >= 0) {
            negociosList[idx] = { ...negociosList[idx], ...payload };
          } else {
            negociosList.unshift({ ...payload, visitas_demo: 0 });
          }
        } else if (SUPABASE_URL) {
          if (isEdit) {
            await fetch(`${SUPABASE_URL}/rest/v1/negocios?id=eq.${encodeURIComponent(id)}`, {
              method: 'PATCH',
              headers: sbHeaders(),
              body: JSON.stringify(payload),
            });
          } else {
            await fetch(`${SUPABASE_URL}/rest/v1/negocios`, {
              method: 'POST',
              headers: sbHeaders(),
              body: JSON.stringify(payload),
            });
          }
          await cargarDatos();
        }

        modalClient?.classList.add('hidden');
        renderSuperAdmin();
        showToast(isEdit ? 'Cliente actualizado' : 'Cliente creado con éxito');
      });

      // Modal Registrar Pago
      const modalPayment = document.getElementById('modal-payment');

      function abrirModalPago(preselectedId?: string) {
        const select = document.getElementById('mp-negocio-id') as HTMLSelectElement;
        select.innerHTML = negociosList
          .map((n) => `<option value="${n.id}">${n.nombre} (${n.modalidad_cobro})</option>`)
          .join('');
        if (preselectedId) select.value = preselectedId;

        const neg = negociosList.find((n) => n.id === select.value);
        if (neg) {
          (document.getElementById('mp-monto') as HTMLInputElement).value = String(
            neg.modalidad_cobro === 'pago_unico' ? neg.monto_unico || 150000 : neg.precio_mensual || 35000
          );
          (document.getElementById('mp-concepto') as HTMLInputElement).value =
            neg.modalidad_cobro === 'pago_unico' ? 'Pago Único Web' : 'Mensualidad';
        }
        (document.getElementById('mp-fecha') as HTMLInputElement).value = new Date().toISOString().slice(0, 10);
        modalPayment?.classList.remove('hidden');
      }

      document.getElementById('mp-negocio-id')?.addEventListener('change', (e) => {
        const id = (e.target as HTMLSelectElement).value;
        const neg = negociosList.find((n) => n.id === id);
        if (neg) {
          (document.getElementById('mp-monto') as HTMLInputElement).value = String(
            neg.modalidad_cobro === 'pago_unico' ? neg.monto_unico || 150000 : neg.precio_mensual || 35000
          );
        }
      });

      document.getElementById('btn-open-payment-modal')?.addEventListener('click', () => abrirModalPago());
      document.getElementById('btn-close-payment-modal')?.addEventListener('click', () => modalPayment?.classList.add('hidden'));
      document.getElementById('btn-cancel-payment-modal')?.addEventListener('click', () => modalPayment?.classList.add('hidden'));

      document.getElementById('form-modal-payment')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const negocio_id = (document.getElementById('mp-negocio-id') as HTMLSelectElement).value;
        const monto = Number((document.getElementById('mp-monto') as HTMLInputElement).value || 0);
        const fecha_pago = (document.getElementById('mp-fecha') as HTMLInputElement).value;
        const concepto = (document.getElementById('mp-concepto') as HTMLInputElement).value.trim();
        const metodo = (document.getElementById('mp-metodo') as HTMLSelectElement).value;
        const avanzarMes = (document.getElementById('mp-avanzar-mes') as HTMLInputElement).checked;

        const nuevoPago = {
          id: 'p_' + Date.now(),
          negocio_id,
          monto,
          fecha_pago,
          concepto,
          metodo,
        };

        const neg = negociosList.find((n) => n.id === negocio_id);
        let nuevoVencimiento: string | null = null;
        if (neg && neg.modalidad_cobro === 'mensual' && avanzarMes) {
          const baseDate = neg.proximo_vencimiento_pago ? new Date(neg.proximo_vencimiento_pago) : new Date();
          baseDate.setMonth(baseDate.getMonth() + 1);
          nuevoVencimiento = baseDate.toISOString().slice(0, 10);
          neg.proximo_vencimiento_pago = nuevoVencimiento;
        } else if (neg && neg.modalidad_cobro === 'pago_unico') {
          neg.estado_pago_unico = 'pagado';
        }

        if (isMockMode) {
          pagosList.unshift(nuevoPago);
        } else if (SUPABASE_URL) {
          await fetch(`${SUPABASE_URL}/rest/v1/pagos`, {
            method: 'POST',
            headers: sbHeaders(),
            body: JSON.stringify({ negocio_id, monto, fecha_pago, concepto, metodo }),
          });
          if (neg && nuevoVencimiento) {
            await fetch(`${SUPABASE_URL}/rest/v1/negocios?id=eq.${encodeURIComponent(negocio_id)}`, {
              method: 'PATCH',
              headers: sbHeaders(),
              body: JSON.stringify({ proximo_vencimiento_pago: nuevoVencimiento }),
            });
          } else if (neg && neg.modalidad_cobro === 'pago_unico') {
            await fetch(`${SUPABASE_URL}/rest/v1/negocios?id=eq.${encodeURIComponent(negocio_id)}`, {
              method: 'PATCH',
              headers: sbHeaders(),
              body: JSON.stringify({ estado_pago_unico: 'pagado' }),
            });
          }
          await cargarDatos();
        }

        modalPayment?.classList.add('hidden');
        renderSuperAdmin();
        showToast(`Cobro de ${formatARS(monto)} registrado`);
      });

      // Tabs Vista Cliente (Estadísticas vs Configuración)
      document.querySelectorAll<HTMLButtonElement>('.client-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.clientTab;
          document.querySelectorAll('.client-tab-btn').forEach((b) => {
            b.classList.remove('bg-violet-600', 'text-white');
            b.classList.add('bg-zinc-800', 'text-zinc-300');
