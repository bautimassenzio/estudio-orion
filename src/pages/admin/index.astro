      // Acciones en la tabla de Negocios
      document.getElementById('crm-tbody-negocios')?.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('button[data-action]') as HTMLButtonElement | null;
        if (!btn) return;
        const action = btn.dataset.action;
        const id = btn.dataset.id || '';
        const negocio = negociosList.find((n) => n.id === id);
        if (!negocio) return;

        if (action === 'set-estado') {
          const nuevoEstado = btn.dataset.estado || 'activo';
          negocio.estado = nuevoEstado;
          if (!isMockMode && SUPABASE_URL) {
            await fetch(`${SUPABASE_URL}/rest/v1/negocios?id=eq.${encodeURIComponent(id)}`, {
              method: 'PATCH',
              headers: sbHeaders(),
              body: JSON.stringify({ estado: nuevoEstado }),
            });
          }
          renderSuperAdmin();
          showToast(`Estado de ${negocio.nombre} cambiado manualmente a: ${nuevoEstado.toUpperCase()}`);
        } else if (action === 'view-client') {
          openClientView(negocio);
        } else if (action === 'edit-client') {
          abrirModalCliente(negocio);
        } else if (action === 'quick-pay') {
          abrirModalPago(negocio.id);
        } else if (action === 'copy-env') {
          const envText = `PUBLIC_SUPABASE_URL="${SUPABASE_URL || 'https://tu-proyecto.supabase.co'}"\nPUBLIC_SUPABASE_ANON_KEY="${SUPABASE_KEY || 'tu-anon-key'}"\nPUBLIC_NEGOCIO_ID="${negocio.id}"`;
