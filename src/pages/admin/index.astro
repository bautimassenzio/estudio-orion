      function renderSuperAdmin() {
        const currentMonthPrefix = new Date().toISOString().slice(0, 7); // YYYY-MM
        const cobradoMes = pagosList
          .filter((p) => String(p.fecha_pago || '').startsWith(currentMonthPrefix))
          .reduce((acc, p) => acc + Number(p.monto || 0), 0);

        const activos = negociosList.filter((n) => n.estado === 'activo');
        const activosMensuales = activos.filter((n) => n.modalidad_cobro === 'mensual');
        const activosPagoUnico = activos.filter((n) => n.modalidad_cobro === 'pago_unico');
        const mrr = activosMensuales.reduce((acc, n) => acc + Number(n.precio_mensual || 0), 0);

        const hoyStr = new Date().toISOString().slice(0, 10);
        const vencidosCount = negociosList.filter(
          (n) =>
            n.estado === 'activo' &&
            n.modalidad_cobro === 'mensual' &&
            n.proximo_vencimiento_pago &&
            n.proximo_vencimiento_pago < hoyStr
        ).length;

        const demos = negociosList.filter((n) => n.estado === 'demo');
        const demosVisitas = demos.reduce((acc, n) => acc + Number(n.visitas_demo || 0), 0);

        (document.getElementById('crm-kpi-cobrado') as HTMLElement).textContent = formatARS(cobradoMes);
        (document.getElementById('crm-kpi-mrr') as HTMLElement).textContent = `${formatARS(mrr)} / mes`;
        (document.getElementById('crm-kpi-vencidos') as HTMLElement).textContent =
          vencidosCount > 0
            ? `⚠️ ${vencidosCount} con fecha de pago vencida (siguen online)`
            : '✓ Todos los clientes mensuales al día';
        (document.getElementById('crm-kpi-activos') as HTMLElement).textContent = String(activos.length);
        (document.getElementById('crm-kpi-activos-sub') as HTMLElement).textContent = `${activosMensuales.length} mensuales · ${activosPagoUnico.length} pago único`;
        (document.getElementById('crm-kpi-demos') as HTMLElement).textContent = String(demos.length);
        (document.getElementById('crm-kpi-demos-visitas') as HTMLElement).textContent = `${demosVisitas} aperturas de prospectos`;
        (document.getElementById('crm-count-pagos') as HTMLElement).textContent = String(pagosList.length);

        renderNegociosTable();
        renderPagosTable();
      }

      function renderNegociosTable() {
        const tbody = document.getElementById('crm-tbody-negocios');
        if (!tbody) return;
        const hoyStr = new Date().toISOString().slice(0, 10);

        const filtered = negociosList.filter((n) => {
          if (currentFilter === 'demo') return n.estado === 'demo';
          if (currentFilter === 'mensual') return n.modalidad_cobro === 'mensual';
          if (currentFilter === 'pago_unico') return n.modalidad_cobro === 'pago_unico';
          if (currentFilter === 'vencido') {
            return (
              n.modalidad_cobro === 'mensual' &&
              n.proximo_vencimiento_pago &&
              n.proximo_vencimiento_pago < hoyStr
            );
          }
          return true;
        });

        if (filtered.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-zinc-500">No hay negocios en este filtro.</td></tr>`;
          return;
        }

        tbody.innerHTML = filtered
          .map((n) => {
            // Badge de estado manual
            let estadoBadge = '';
            if (n.estado === 'activo') {
              estadoBadge = `<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 px-2.5 py-1 text-xs font-bold text-emerald-300">🟢 Activo</span>`;
            } else if (n.estado === 'demo') {
              estadoBadge = `<span class="inline-flex items-center gap-1.5 rounded-full bg-violet-500/15 border border-violet-500/30 px-2.5 py-1 text-xs font-bold text-violet-300">🚀 En Demo</span>`;
