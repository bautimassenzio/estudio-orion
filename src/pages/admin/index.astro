---
import '../../styles/global.css';

const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL || 'https://gpsmxjevfocjaoitxdbg.supabase.co';
const supabaseAnonKey =
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdwc214amV2Zm9jamFvaXR4ZGJnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ2ODgwNTcsImV4cCI6MjExMDI2NDA1N30.AW741xfPval4mojw6eBaS1MWbux5uvTdr2ZyIutK_yk';
const superAdminEmail = import.meta.env.PUBLIC_SUPERADMIN_EMAIL || 'orion@admin.com';
---

<!doctype html>
<html lang="es-AR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Panel de Control & CRM | Estudio Orion</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen antialiased selection:bg-violet-600 selection:text-white">
    <!-- Config inyectada desde Astro -->
    <div
      id="orion-admin-env"
      data-url={supabaseUrl}
      data-key={supabaseAnonKey}
      data-admin-email={superAdminEmail}
      class="hidden"
    ></div>

    <!-- Fondo sutil -->
    <div class="fixed inset-0 bg-subtle-grid pointer-events-none opacity-40 z-0"></div>

    <!-- ===================================================================== -->
    <!-- PANTALLA 1: LOGIN                                                     -->
    <!-- ===================================================================== -->
    <main id="view-login" class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4 py-12">
      <div class="w-full max-w-md">
        <!-- Logo & Header -->
        <div class="text-center mb-8">
          <a href="/" class="inline-flex items-center gap-2.5 mb-3 group">
            <div class="w-10 h-10 rounded-xl bg-violet-600/20 border border-violet-500/40 flex items-center justify-center text-violet-400 font-extrabold text-lg">
              O
            </div>
            <span class="font-bold text-xl tracking-tight text-white">Estudio Orion</span>
          </a>
          <h1 class="text-2xl font-extrabold text-white">Panel de Administración</h1>
          <p class="text-sm text-zinc-400 mt-1">
            Ingresá con tu cuenta para ver tus estadísticas, gestionar tu web o administrar clientes.
          </p>
        </div>

        <!-- Card de Login -->
        <div class="rounded-2xl border border-zinc-800/90 bg-zinc-900/80 backdrop-blur-md p-6 sm:p-8 shadow-2xl">
          <div id="login-error" class="hidden mb-4 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-xs text-red-300"></div>

          <form id="form-login" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">
                Correo Electrónico
              </label>
              <input
                id="login-email"
                type="email"
                required
                placeholder="tu@correo.com"
                class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-white placeholder-zinc-500 focus:border-violet-500 focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-1.5">
                Contraseña
              </label>
              <input
                id="login-password"
                type="password"
                required
                placeholder="••••••••"
                class="w-full rounded-xl border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-white placeholder-zinc-500 focus:border-violet-500 focus:outline-none"
              />
            </div>

            <button
              id="btn-login-submit"
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 disabled:opacity-60 disabled:pointer-events-none px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-600/20 transition cursor-pointer"
            >
              <svg
                id="login-spinner"
                class="hidden h-4 w-4 animate-spin text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
              <span id="login-btn-text">Iniciar Sesión</span>
            </button>
          </form>
        </div>

        <p class="text-center text-xs text-zinc-500 mt-6">
          <a href="/" class="hover:text-zinc-300 transition">← Volver a orionestudio.com.ar</a>
        </p>
      </div>
    </main>

    <!-- ===================================================================== -->
    <!-- BARRA SUPERIOR COMPARTIDA (LOGUEADO)                                  -->
    <!-- ===================================================================== -->
    <header id="admin-topbar" class="hidden sticky top-0 z-40 border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-violet-600 flex items-center justify-center text-white font-extrabold text-sm">
              O
            </div>
            <span class="font-bold text-base text-white hidden sm:inline">Orion Admin</span>
          </a>
          <span id="topbar-role-badge" class="rounded-full px-2.5 py-0.5 text-xs font-bold bg-violet-500/15 text-violet-300 border border-violet-500/30">
            SuperAdmin
          </span>
          <span id="topbar-demo-indicator" class="hidden rounded-full px-2.5 py-0.5 text-[11px] font-semibold bg-amber-500/15 text-amber-300 border border-amber-500/30">
            Modo Prueba Local
          </span>
        </div>

        <div class="flex items-center gap-3">
          <!-- Botón para volver al CRM cuando SuperAdmin está espiando la vista de un cliente -->
          <button
            id="btn-back-to-crm"
            type="button"
            class="hidden rounded-xl border border-violet-500/40 bg-violet-500/15 hover:bg-violet-500/25 px-3.5 py-1.5 text-xs font-bold text-violet-200 transition cursor-pointer"
          >
            ← Volver a mi CRM
          </button>
          <span id="topbar-user-email" class="text-xs text-zinc-400 hidden md:inline"></span>
          <button
            id="btn-logout"
            type="button"
            class="rounded-xl border border-zinc-800 bg-zinc-900 hover:bg-zinc-800 px-3.5 py-1.5 text-xs font-semibold text-zinc-300 transition cursor-pointer"
          >
            Cerrar Sesión
          </button>
        </div>
      </div>
    </header>

    <!-- ===================================================================== -->
    <!-- PANTALLA 2: VISTA SUPERADMIN (CRM + CONTROL DE PAGOS Y DEMOS)         -->
    <!-- ===================================================================== -->
    <section id="view-superadmin" class="hidden relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <!-- Encabezado y Acciones Principales -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white">CRM & Control de Licencias</h1>
          <p class="text-sm text-zinc-400 mt-1">
            Ninguna web se desactiva sola por fecha: vos decidís manualmente cuándo activar o suspender cada sitio.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
          <button
            id="btn-crm-preview-client"
            type="button"
            class="rounded-xl border border-zinc-700 bg-zinc-800/80 hover:bg-zinc-800 px-4 py-2.5 text-xs sm:text-sm font-semibold text-zinc-200 transition cursor-pointer"
          >
            👁️ Vista Previa Panel Cliente
          </button>
          <button
            id="btn-open-payment-modal"
            type="button"
            class="rounded-xl border border-emerald-500/40 bg-emerald-500/15 hover:bg-emerald-500/25 px-4 py-2.5 text-xs sm:text-sm font-bold text-emerald-300 transition cursor-pointer"
          >
            💸 Registrar Pago
          </button>
          <button
            id="btn-open-new-client"
            type="button"
            class="rounded-xl bg-violet-600 hover:bg-violet-500 px-4 py-2.5 text-xs sm:text-sm font-bold text-white shadow-lg shadow-violet-600/25 transition cursor-pointer"
          >
            + Nuevo Cliente / Demo
          </button>
        </div>
      </div>

      <!-- KPIs Financieros y Comerciales -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-5">
          <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Cobrado este mes</span>
          <p id="crm-kpi-cobrado" class="text-2xl font-extrabold text-emerald-400 mt-1">$0</p>
          <p id="crm-kpi-cobrado-sub" class="text-xs text-zinc-500 mt-1">Mensualidades + Pagos únicos</p>
        </div>
        <div class="rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-5">
          <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Mensualidades Recurrentes</span>
          <p id="crm-kpi-mrr" class="text-2xl font-extrabold text-white mt-1">$0 / mes</p>
          <p id="crm-kpi-vencidos" class="text-xs text-amber-400 mt-1">0 pendientes de cobro</p>
        </div>
        <div class="rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-5">
          <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Clientes Activos</span>
          <p id="crm-kpi-activos" class="text-2xl font-extrabold text-white mt-1">0</p>
          <p id="crm-kpi-activos-sub" class="text-xs text-zinc-500 mt-1">0 mensuales · 0 pago único</p>
        </div>
        <div class="rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-5">
          <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Demos en Prospección</span>
          <p id="crm-kpi-demos" class="text-2xl font-extrabold text-violet-400 mt-1">0</p>
          <p id="crm-kpi-demos-visitas" class="text-xs text-zinc-400 mt-1">0 aperturas totales</p>
        </div>
      </div>

      <!-- Pestañas SuperAdmin: Proyectos vs Historial de Caja -->
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-zinc-800 pb-3">
        <div class="flex items-center gap-2">
          <button
            data-crm-tab="negocios"
            class="crm-tab-btn rounded-xl bg-violet-600 text-white px-4 py-2 text-xs font-bold transition cursor-pointer"
          >
            🌐 Clientes y Demos
          </button>
          <button
            data-crm-tab="pagos"
            class="crm-tab-btn rounded-xl bg-zinc-900 text-zinc-400 hover:text-white px-4 py-2 text-xs font-bold transition cursor-pointer"
          >
            💰 Historial de Pagos (<span id="crm-count-pagos">0</span>)
          </button>
        </div>

        <!-- Filtros rápidos de clientes -->
        <div id="crm-filters" class="flex flex-wrap items-center gap-1.5">
          <button data-filter="todos" class="crm-filter-btn rounded-lg bg-zinc-800 text-white px-3 py-1.5 text-xs font-semibold cursor-pointer">
            Todos
          </button>
          <button data-filter="demo" class="crm-filter-btn rounded-lg bg-zinc-900 text-zinc-400 hover:text-white px-3 py-1.5 text-xs font-semibold cursor-pointer">
            🚀 Demos
          </button>
          <button data-filter="mensual" class="crm-filter-btn rounded-lg bg-zinc-900 text-zinc-400 hover:text-white px-3 py-1.5 text-xs font-semibold cursor-pointer">
            🔄 Mensuales
          </button>
          <button data-filter="pago_unico" class="crm-filter-btn rounded-lg bg-zinc-900 text-zinc-400 hover:text-white px-3 py-1.5 text-xs font-semibold cursor-pointer">
            💎 Pago Único
          </button>
          <button data-filter="vencido" class="crm-filter-btn rounded-lg bg-zinc-900 text-amber-400 hover:text-amber-300 px-3 py-1.5 text-xs font-semibold cursor-pointer">
            ⚠️ Pago Pendiente
          </button>
        </div>
      </div>

      <!-- TABLA 1: NEGOCIOS (CLIENTES Y DEMOS) -->
      <div id="crm-panel-negocios" class="rounded-2xl border border-zinc-800/90 bg-zinc-900/60 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-zinc-800 text-[11px] font-bold uppercase tracking-wider text-zinc-400 bg-zinc-900/90">
                <th class="py-3.5 px-4">Negocio / ID</th>
                <th class="py-3.5 px-4">Estado del Sitio (Manual)</th>
                <th class="py-3.5 px-4">Plan y Cobranza</th>
                <th class="py-3.5 px-4">Visitas Demo</th>
                <th class="py-3.5 px-4 text-right">Acciones Rápidas</th>
              </tr>
            </thead>
            <tbody id="crm-tbody-negocios" class="divide-y divide-zinc-800/60 text-sm"></tbody>
          </table>
        </div>
      </div>

      <!-- TABLA 2: HISTORIAL DE PAGOS / CAJA -->
      <div id="crm-panel-pagos" class="hidden rounded-2xl border border-zinc-800/90 bg-zinc-900/60 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-zinc-800 text-[11px] font-bold uppercase tracking-wider text-zinc-400 bg-zinc-900/90">
                <th class="py-3.5 px-4">Fecha</th>
                <th class="py-3.5 px-4">Cliente</th>
                <th class="py-3.5 px-4">Concepto</th>
                <th class="py-3.5 px-4">Método</th>
                <th class="py-3.5 px-4">Monto</th>
                <th class="py-3.5 px-4 text-right">Acción</th>
              </tr>
            </thead>
            <tbody id="crm-tbody-pagos" class="divide-y divide-zinc-800/60 text-sm"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- PANTALLA 3: VISTA CLIENTE (ESTADÍSTICAS UTM + EDICIÓN DE SITIO)       -->
    <!-- ===================================================================== -->
    <section id="view-cliente" class="hidden relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <!-- Encabezado del Cliente -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 rounded-2xl border border-zinc-800/90 bg-zinc-900/75 p-6">
        <div>
          <div class="flex items-center gap-2.5">
            <h1 id="client-header-name" class="text-2xl font-extrabold text-white">Mi Negocio</h1>
            <span id="client-header-status" class="rounded-full px-2.5 py-0.5 text-xs font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
              Sitio Activo
            </span>
          </div>
          <p id="client-header-plan" class="text-xs text-zinc-400 mt-1">
            Métricas de rendimiento y configuración general del sitio web
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button
            data-client-tab="stats"
            class="client-tab-btn inline-flex items-center gap-2 rounded-xl bg-violet-600 text-white px-4 py-2.5 text-xs font-bold transition cursor-pointer"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Estadísticas y Orígenes</span>
          </button>
          <button
            data-client-tab="config"
            class="client-tab-btn inline-flex items-center gap-2 rounded-xl bg-zinc-800 text-zinc-300 hover:text-white px-4 py-2.5 text-xs font-bold transition cursor-pointer"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            <span>Configuración y Contacto</span>
          </button>
        </div>
      </div>

      <!-- SUB-VISTA CLIENTE 1: ESTADÍSTICAS Y UTM -->
      <div id="client-panel-stats" class="space-y-6">
        <!-- Tarjetas de Métricas -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Visitas al Sitio Web</span>
            <p id="client-kpi-visits" class="text-3xl font-extrabold text-white mt-2">0</p>
            <p class="text-xs text-zinc-500 mt-1">Sesiones totales registradas</p>
          </div>
          <div class="rounded-2xl border border-emerald-500/30 bg-emerald-500/5 p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Contactos por WhatsApp</span>
            <p id="client-kpi-wpp" class="text-3xl font-extrabold text-emerald-400 mt-2">0</p>
            <p class="text-xs text-zinc-400 mt-1">Consultas directas iniciadas desde la web</p>
          </div>
          <div class="rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Tasa de Conversión</span>
            <p id="client-kpi-conv" class="text-3xl font-extrabold text-violet-400 mt-2">0%</p>
            <p class="text-xs text-zinc-500 mt-1">Porcentaje de visitas que inician consulta</p>
          </div>
        </div>

        <!-- Desglose por Red Social / Origen UTM + Últimos Clics -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- ¿De dónde vienen las visitas? -->
          <div class="lg:col-span-7 rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-6 flex flex-col justify-between">
            <div>
              <h2 class="text-base font-bold text-white">Origen del Tráfico</h2>
              <p class="text-xs text-zinc-400 mt-0.5">
                Distribución de visitas y consultas según el canal de procedencia (parámetros UTM y referencia).
              </p>
              <div id="client-origins-bars" class="mt-6 space-y-4"></div>
            </div>

            <!-- Generador de Links con UTM para sus Redes -->
            <div class="mt-8 pt-5 border-t border-zinc-800">
              <div class="flex items-center gap-2 mb-1">
                <svg class="h-4 w-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
                <p class="text-xs font-bold text-zinc-200">
                  Enlaces de seguimiento para perfiles sociales
                </p>
              </div>
              <p class="text-[11px] text-zinc-400 mb-3">
                Utilice estos enlaces en la biografía de sus redes sociales para contabilizar con precisión el tráfico proveniente de cada plataforma:
              </p>
              <div class="flex flex-wrap gap-2">
                <button
                  data-copy-utm="instagram"
                  type="button"
                  class="utm-copy-btn inline-flex items-center gap-1.5 rounded-xl border border-zinc-700 bg-zinc-800/80 hover:bg-zinc-800 px-3 py-2 text-xs font-semibold text-zinc-200 transition cursor-pointer"
                >
                  <span>Copiar enlace para Instagram</span>
                </button>
                <button
                  data-copy-utm="facebook"
                  type="button"
                  class="utm-copy-btn inline-flex items-center gap-1.5 rounded-xl border border-zinc-700 bg-zinc-800/80 hover:bg-zinc-800 px-3 py-2 text-xs font-semibold text-zinc-200 transition cursor-pointer"
                >
                  <span>Copiar enlace para Facebook</span>
                </button>
                <button
                  data-copy-utm="tiktok"
                  type="button"
                  class="utm-copy-btn inline-flex items-center gap-1.5 rounded-xl border border-zinc-700 bg-zinc-800/80 hover:bg-zinc-800 px-3 py-2 text-xs font-semibold text-zinc-200 transition cursor-pointer"
                >
                  <span>Copiar enlace para TikTok</span>
                </button>
              </div>
            </div>
          </div>

          <!-- Actividad reciente -->
          <div class="lg:col-span-5 rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-6">
            <h2 class="text-base font-bold text-white">Actividad de Contacto Reciente</h2>
            <p class="text-xs text-zinc-400 mt-0.5">
              Últimas interacciones registradas hacia WhatsApp desde el sitio web.
            </p>
            <div id="client-recent-events" class="mt-5 space-y-3 max-h-80 overflow-y-auto pr-1"></div>
          </div>
        </div>
      </div>

      <!-- SUB-VISTA CLIENTE 2: EDITAR CONTACTO, REDES Y BANNER -->
      <div id="client-panel-config" class="hidden rounded-2xl border border-zinc-800/90 bg-zinc-900/70 p-6 sm:p-8">
        <div class="max-w-3xl">
          <h2 class="text-lg font-bold text-white">Información de Contacto, Redes y Aviso Superior</h2>
          <p class="text-xs text-zinc-400 mt-1">
            Los cambios guardados en esta sección se aplican de forma inmediata en el sitio web público.
          </p>

          <form id="form-client-config" class="mt-6 space-y-6">
            <!-- Barra Superior de Promoción / Aviso -->
            <div class="rounded-xl border border-violet-500/30 bg-violet-500/5 p-4 space-y-3">
