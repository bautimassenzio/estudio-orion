---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-950 border-t border-gray-900 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Brand & Copy -->
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="4" r="2" fill="currentColor"/>
            <circle cx="7" cy="12" r="1.5" fill="currentColor"/>
            <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
            <circle cx="17" cy="12" r="1.5" fill="currentColor"/>
            <circle cx="6" cy="20" r="2" fill="currentColor"/>
            <circle cx="18" cy="20" r="2" fill="currentColor"/>
            <path d="M12 4L7 12h10L12 4z" stroke-width="1.2" stroke-opacity="0.6"/>
          </svg>
        </div>
        <span class="text-sm font-semibold text-gray-200">
          Estudio Orión <span class="text-gray-500 font-normal">| Soluciones Informáticas & Desarrollo a Medida</span>
        </span>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6 text-xs text-gray-400">
        <a href="#servicios" class="hover:text-cyan-400 transition">Servicios</a>
        <a href="#ventajas" class="hover:text-cyan-400 transition">Ventajas</a>
        <a href="#proceso" class="hover:text-cyan-400 transition">Proceso</a>
        <a href="#faq" class="hover:text-cyan-400 transition">Preguntas frecuentes</a>
        <a href="#contacto" class="hover:text-cyan-400 transition">Contacto</a>
      </div>

      <!-- Copyright -->
      <div class="text-xs text-gray-500">
        © {currentYear} Estudio Orión. Todos los derechos reservados.
      </div>

    </div>
  </div>
</footer>
