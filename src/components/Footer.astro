---
const currentYear = new Date().getFullYear();
---

<footer class="bg-black border-t border-zinc-900 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Brand & Copy -->
      <div class="flex items-center gap-3">
        <img 
          src="/logo.png" 
          alt="Orion Estudio Logo" 
          class="h-8 w-auto object-contain"
        />
        <span class="text-sm font-semibold text-white">
          Orion Estudio <span class="text-zinc-500 font-normal">| orionestudio.com.ar</span>
        </span>
      </div>

      <!-- Links -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-zinc-400">
        <a href="#nosotros" class="hover:text-white transition">Nosotros</a>
        <a href="#servicios" class="hover:text-white transition">Servicios</a>
        <a href="#ventajas" class="hover:text-white transition">Por qué elegirnos</a>
        <a href="#proceso" class="hover:text-white transition">Método</a>
        <a href="#faq" class="hover:text-white transition">Preguntas frecuentes</a>
        <a href="#contacto" class="hover:text-white transition">Contacto</a>
      </div>

      <!-- Copyright -->
      <div class="text-xs text-zinc-500">
        © {currentYear} Orion Estudio. Todos los derechos reservados.
      </div>

    </div>
  </div>
</footer>
