---
const services = [
  {
    title: "Landing Pages & Sitios Web de Conversión",
    tagline: "Presencia digital comercial",
    description: "Diseñadas para captar clientes desde publicidad, redes o referencias directas. Páginas ultralivianas, pensadas para celulares y con llamados a la acción claros hacia tu WhatsApp o formulario.",
    features: [
      "Diseño a medida responsivo y de carga instantánea",
      "Estructura comercial pensada para vender",
      "Integración directa con WhatsApp y correo",
      "Sin costos mensuales obligatorios de servidor"
    ],
    popular: true
  },
  {
    title: "Software & Sistemas de Gestión a Medida",
    tagline: "Optimización operativa",
    description: "Para empresas que necesitan digitalizar sus procesos: paneles de administración, turneros online, cotizadores de presupuestos, gestión de clientes o control de stock.",
    features: [
      "Acceso seguro con usuarios y roles",
      "Bases de datos en la nube seguras y respaldadas",
      "Desarrollado exactamente según tus reglas de trabajo",
      "Reportes claros de la actividad de tu negocio"
    ],
    popular: false
  },
  {
    title: "Automatización & Integraciones Digitales",
    tagline: "Procesos en piloto automático",
    description: "Conectamos las herramientas que ya usás: cobros automáticos con Mercado Pago o Stripe, recordatorios por WhatsApp a tus clientes y sincronización de datos sin tareas manuales.",
    features: [
      "Cobros digitales con confirmación instantánea",
      "Avisos automáticos a clientes vía WhatsApp o email",
      "Conexión con planillas y bases de datos",
      "Ahorro de horas semanales de trabajo repetitivo"
    ],
    popular: false
  }
];
---

<section id="servicios" class="py-24 bg-zinc-950/60 border-y border-zinc-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-zinc-400 font-semibold">Nuestros Servicios</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Soluciones informáticas adaptadas a tu negocio.
      </p>
      <p class="mt-4 text-base sm:text-lg text-zinc-400">
        Desde una presencia web que convierta visitantes en clientes, hasta sistemas a medida que ordenen y automaticen tu empresa.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
      {services.map((service) => (
        <div class={`relative flex flex-col justify-between p-8 sm:p-9 rounded-2xl transition-all duration-200 ${
          service.popular 
            ? 'bg-zinc-900/90 border-2 border-white shadow-xl' 
            : 'bg-zinc-950 border border-zinc-900 hover:border-zinc-800'
        }`}>
          {service.popular && (
            <div class="absolute -top-3.5 left-8 px-3 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white text-black">
              Más Solicitado
            </div>
          )}

          <div>
            <div class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2">
              {service.tagline}
            </div>
            <h3 class="text-xl font-bold text-white mb-3">
              {service.title}
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed mb-6">
              {service.description}
            </p>

            <div class="border-t border-zinc-800/80 pt-6 mb-8">
              <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300 block mb-4">
                Qué resolvemos:
              </span>
              <ul class="space-y-3">
                {service.features.map((item) => (
                  <li class="flex items-start gap-3 text-sm text-zinc-300">
                    <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <a
            href="#contacto"
            class={`w-full py-3 rounded-xl text-sm font-semibold text-center transition-all ${
              service.popular
                ? 'bg-white hover:bg-zinc-200 text-black'
                : 'bg-zinc-900 hover:bg-zinc-850 text-white border border-zinc-800 hover:border-zinc-700'
            }`}
          >
            Consultar por este servicio
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
