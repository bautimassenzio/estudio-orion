---
const services = [
  {
    title: "Landing Pages & Sitios Web de Alto Impacto",
    tagline: "Presencia digital que vende",
    description: "Diseñadas estratégicamente para captar clientes desde publicidad o redes. Páginas con diseño premium, carga instantánea y optimizadas para que el visitante haga clic en tu WhatsApp o formulario.",
    features: [
      "Diseño a medida optimizado para celulares",
      "Redacción estratégica enfocada en conversión",
      "Conexión directa a tu WhatsApp o correo",
      "Sin costos mensuales de mantenimiento de servidor"
    ],
    popular: true
  },
  {
    title: "Sistemas & Software de Gestión a Medida",
    tagline: "Digitalizá tu operativa",
    description: "Para empresas y profesionales que necesitan más que una web estática: paneles de control, turneros online, cotizadores de precios, gestión de presupuestos o control de clientes y stock.",
    features: [
      "Paneles de administración seguros con usuario y clave",
      "Bases de datos protegidas y automáticas en la nube",
      "Adaptado 100% a las reglas de tu negocio",
      "Reportes y métricas de tu actividad en tiempo real"
    ],
    popular: false
  },
  {
    title: "Automatización de Procesos & Conectividad",
    tagline: "Tu negocio en piloto automático",
    description: "Eliminamos el trabajo manual repetitivo. Conectamos tus canales de venta con pasarelas de pago (Mercado Pago, Stripe), recordatorios automáticos por WhatsApp y sincronización de datos.",
    features: [
      "Cobros online y confirmación automática",
      "Mensajería y avisos automáticos a clientes",
      "Integración de sistemas y planillas",
      "Ahorro de horas semanales de gestión manual"
    ],
    popular: false
  }
];
---

<section id="servicios" class="py-24 bg-gray-950/60 border-y border-gray-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-bold">Nuestros Servicios</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Soluciones informáticas pensadas para tu negocio.
      </p>
      <p class="mt-4 text-base sm:text-lg text-gray-400">
        Brindamos herramientas tecnológicas a medida: desde una página web atractiva para validar un servicio, hasta software personalizado para organizar tu empresa.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {services.map((service) => (
        <div class={`relative flex flex-col justify-between p-8 sm:p-10 rounded-3xl transition-all duration-300 ${
          service.popular 
            ? 'bg-gradient-to-b from-gray-900 to-gray-950 border-2 border-cyan-500 shadow-2xl shadow-cyan-500/10 -translate-y-2' 
            : 'bg-gray-900/40 border border-gray-800/80 hover:border-gray-700'
        }`}>
          {service.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-cyan-500 to-indigo-600 text-white shadow-md">
              Solución Destacada
            </div>
          )}

          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-cyan-400 mb-2">
              {service.tagline}
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">
              {service.title}
            </h3>
            <p class="text-sm text-gray-400 leading-relaxed mb-6">
              {service.description}
            </p>

            <div class="border-t border-gray-800/80 pt-6 mb-8">
              <span class="text-xs font-semibold uppercase tracking-wider text-gray-300 block mb-4">
                Lo que resolvemos:
              </span>
              <ul class="space-y-3">
                {service.features.map((item) => (
                  <li class="flex items-start gap-3 text-sm text-gray-300">
                    <svg class="w-5 h-5 text-cyan-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <a
            href="#contacto"
            class={`w-full py-3.5 rounded-xl text-sm font-bold text-center transition-all ${
              service.popular
                ? 'bg-cyan-500 hover:bg-cyan-400 text-gray-950 shadow-lg shadow-cyan-500/20'
                : 'bg-gray-800 hover:bg-gray-750 text-white border border-gray-700'
            }`}
          >
            Pedir cotización de este servicio
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
