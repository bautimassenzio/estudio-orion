---
const projects = [
  {
    id: "pormastango",
    number: "01",
    badgePrimary: "E-commerce + Software",
    badgeSecondary: "Indumentaria Urbana",
    title: "Por Más Tango",
    domain: "por-mastango.com.ar",
    url: "https://por-mastango.com.ar",
    description:
      "Plataforma integral de comercio electrónico desarrollada a medida. Combina una tienda online rápida y minimalista para los clientes con un panel de control privado para administrar toda la operación de la marca.",
    features: [
      "Catálogo dinámico con selector de talles y carrito de compras.",
      "Dashboard administrativo con métricas de facturación mensual.",
      "Control de stock en taller, alta de productos y categorías.",
      "Gestión de pedidos pendientes, despachos y canal mayorista."
    ],
    views: [
      {
        id: "tango-1",
        label: "01. Tienda & Catálogo",
        caption: "Portada comercial y catálogo dinámico de colecciones con acceso a venta minorista y mayorista.",
        img: "/tango1.jpg",
        alt: "Por Más Tango - Catálogo e Inicio",
        isMobile: false
      },
      {
        id: "tango-2",
        label: "02. Producto & Carrito",
        caption: "Ficha de producto con selección de talles (S a XXL), detalle de prenda y carrito en tiempo real.",
        img: "/tango2.jpg",
        alt: "Por Más Tango - Ficha de Producto",
        isMobile: false
      },
      {
        id: "tango-3",
        label: "03. Panel de Administración",
        caption: "Sistema interno a medida: métricas de facturación, control de stock en taller, pedidos mayoristas y despachos.",
        img: "/tango3.jpeg",
        alt: "Por Más Tango - Panel de Administración",
        isMobile: false
      }
    ]
  },
  {
    id: "franciscoalvero",
    number: "02",
    badgePrimary: "Landing Page de Conversión",
    badgeSecondary: "Eventos & Espectáculos",
    title: "Francisco Alvero — El Juglar Argentino",
    domain: "franciscoalvero.com.ar",
    url: "https://franciscoalvero.com.ar",
    description:
      "Landing page comercial de alto impacto diseñada para la contratación de shows musicales y serenatas en vivo. Enfocada en transmitir la identidad artística, mostrar propuestas y facilitar la reserva inmediata de fechas por WhatsApp.",
    features: [
      "Reproductor de audio integrado para escuchar al artista mientras se navega.",
      "Catálogo de formatos de show, promociones vigentes y videos en vivo.",
      "Selector regional y sedes con mapas interactivos (CABA y Entre Ríos).",
      "Experiencia 100% optimizada para celulares con tarjetas deslizables."
    ],
    views: [
      {
        id: "fran-1",
        label: "01. Shows & Reproductor",
        caption: "Sección de propuestas y promociones de shows con reproductor de audio flotante y selector de país.",
        img: "/fran1.png",
        alt: "Francisco Alvero - Shows y Promociones",
        isMobile: false
      },
      {
        id: "fran-2",
        label: "02. Sedes & Reserva",
        caption: "Cierre comercial con acceso inmediato a WhatsApp, llamada directa y ubicación de sedes oficiales.",
        img: "/fran2.png",
        alt: "Francisco Alvero - Contacto y Sedes",
        isMobile: false
      },
      {
        id: "fran-3",
        label: "03. Vista Mobile",
        caption: "Diseño adaptativo para celulares con navegación táctil de promociones, reproductor y WhatsApp flotante.",
        img: "/fran 3 mobile.png",
        alt: "Francisco Alvero - Versión Mobile",
        isMobile: true
      }
    ]
  }
];
---

<section id="proyectos" class="py-24 relative border-t border-zinc-900 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado y Controles de Deslizamiento -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <h2 class="text-xs uppercase tracking-widest text-zinc-400 font-semibold">Casos de Éxito Reales</h2>
        <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
          Desarrollos en producción que impulsan negocios.
        </p>
        <p class="mt-3 text-base text-zinc-400">
          Deslizá hacia el costado para explorar nuestros proyectos reales de software, e-commerce y landing pages.
        </p>
      </div>

      <!-- Botones de navegación del Carrusel -->
      <div class="flex items-center gap-3 self-start md:self-end shrink-0">
        <!-- Pestañas rápidas por proyecto -->
        <div class="hidden sm:flex items-center bg-zinc-950 border border-zinc-800 rounded-xl p-1 mr-2">
          {projects.map((p, idx) => (
            <button
              type="button"
              data-slide-to={idx}
              class={`case-nav-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${
                idx === 0
                  ? 'bg-white text-black'
                  : 'text-zinc-400 hover:text-white'
              }`}
            >
              {p.number}. {p.title.split('—')[0].trim()}
            </button>
          ))}
        </div>

        <button
          type="button"
          id="case-prev"
          aria-label="Proyecto anterior"
          class="w-11 h-11 rounded-xl bg-zinc-950 border border-zinc-800 hover:border-zinc-600 text-white flex items-center justify-center transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          id="case-next"
          aria-label="Siguiente proyecto"
          class="w-11 h-11 rounded-xl bg-white hover:bg-zinc-200 text-black flex items-center justify-center transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Carrusel Horizontal Deslizable -->
    <div
      id="cases-slider"
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 no-scrollbar"
    >
      {projects.map((project, projectIdx) => (
        <div
          class="w-full shrink-0 snap-center rounded-3xl bg-zinc-950 border border-zinc-900 p-6 sm:p-10 lg:p-12"
          data-case-slide={projectIdx}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            
            <!-- Columna de Información -->
            <div class="lg:col-span-5 space-y-6">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white text-black">
                    {project.badgePrimary}
                  </span>
                  <span class="px-3 py-1 rounded-full text-[11px] font-medium bg-zinc-900 text-zinc-300 border border-zinc-800">
                    {project.badgeSecondary}
                  </span>
                </div>
                <span class="text-xs font-mono text-zinc-500">
                  Caso {projectIdx + 1} de {projects.length}
                </span>
              </div>

              <div>
                <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                  {project.title}
                </h3>
                <p class="text-xs text-zinc-500 font-mono mt-1">
                  {project.domain}
                </p>
              </div>

              <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
                {project.description}
              </p>

              <div class="border-t border-zinc-900 pt-5">
                <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300 block mb-3.5">
                  Soluciones implementadas:
                </span>
                <ul class="space-y-2.5 text-sm text-zinc-300">
                  {project.features.map((feat) => (
                    <li class="flex items-start gap-2.5">
                      <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                      </svg>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-4 flex flex-col sm:flex-row gap-3">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-6 py-3 rounded-xl text-sm font-semibold text-black bg-white hover:bg-zinc-200 transition text-center inline-flex items-center justify-center gap-2"
                >
                  <span>Visitar sitio web</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
                <a
                  href="#contacto"
                  class="px-6 py-3 rounded-xl text-sm font-semibold text-white bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 transition text-center"
                >
                  Cotizar un proyecto así
                </a>
              </div>
            </div>

            <!-- Columna de Galería Interactiva -->
            <div class="lg:col-span-7">
              <div class="flex flex-wrap gap-2 mb-4">
                {project.views.map((v, index) => (
                  <button
                    type="button"
                    data-project-btn={project.id}
                    data-target={v.id}
                    class={`project-tab px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer border ${
                      index === 0
                        ? 'bg-white text-black border-white'
                        : 'bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-white hover:border-zinc-700'
                    }`}
                  >
                    {v.label}
                  </button>
                ))}
              </div>

              <!-- Marco estilo navegador -->
              <div class="rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-900 shadow-2xl">
                <div class="bg-zinc-900 px-4 py-2.5 border-b border-zinc-800 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                  </div>
                  <span class="text-[11px] font-mono text-zinc-400">{project.domain}</span>
                  <div class="w-10"></div>
                </div>

                {project.views.map((v, index) => (
                  <div
                    id={v.id}
                    data-project-panel={project.id}
                    class={`project-panel ${index === 0 ? 'block' : 'hidden'}`}
                  >
                    <div class="aspect-[16/10] w-full bg-zinc-950 overflow-hidden flex items-center justify-center relative">
                      {v.isMobile ? (
                        <div class="h-full py-3 flex items-center justify-center">
                          <img
                            src={v.img}
                            alt={v.alt}
                            class="h-full w-auto object-contain rounded-xl border border-zinc-700 shadow-2xl"
                            loading="lazy"
                          />
                        </div>
                      ) : (
                        <img
                          src={v.img}
                          alt={v.alt}
                          class="w-full h-full object-cover object-top"
                          loading="lazy"
                        />
                      )}
                    </div>
                    <div class="p-4 bg-zinc-950 border-t border-zinc-900 flex items-center justify-between gap-4">
                      <p class="text-xs text-zinc-400">
                        {v.caption}
                      </p>
                      <span class="text-[11px] font-mono text-zinc-500 shrink-0">
                        Vista {index + 1}/{project.views.length}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Indicadores inferiores (Dots) -->
    <div class="flex items-center justify-center gap-2 mt-6">
      {projects.map((_, idx) => (
        <button
          type="button"
          data-slide-to={idx}
          aria-label={`Ir al caso ${idx + 1}`}
          class={`case-dot h-2 rounded-full transition-all cursor-pointer ${
            idx === 0 ? 'w-8 bg-white' : 'w-2 bg-zinc-800 hover:bg-zinc-600'
          }`}
        ></button>
      ))}
    </div>

  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  // 1. Cambio de pestañas de imágenes dentro de cada proyecto
  const buttons = document.querySelectorAll('.project-tab');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const projectId = btn.getAttribute('data-project-btn');
      const targetId = btn.getAttribute('data-target');

      if (!projectId || !targetId) return;

      const projectButtons = document.querySelectorAll(`[data-project-btn="${projectId}"]`);
      const projectPanels = document.querySelectorAll(`[data-project-panel="${projectId}"]`);

      projectButtons.forEach((b) => {
        b.classList.remove('bg-white', 'text-black', 'border-white');
        b.classList.add('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
      });

      btn.classList.remove('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
      btn.classList.add('bg-white', 'text-black', 'border-white');

      projectPanels.forEach((panel) => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.remove('block');
          panel.classList.add('hidden');
        }
      });
    });
  });

  // 2. Deslizamiento horizontal entre Casos de Éxito
  const slider = document.getElementById('cases-slider');
  const slides = document.querySelectorAll('[data-case-slide]');
  const prevBtn = document.getElementById('case-prev');
  const nextBtn = document.getElementById('case-next');
  const pills = document.querySelectorAll('.case-nav-pill');
  const dots = document.querySelectorAll('.case-dot');

  let currentIndex = 0;

  function updateIndicators(index: number) {
    currentIndex = index;

    pills.forEach((pill, i) => {
      if (i === index) {
        pill.classList.add('bg-white', 'text-black');
        pill.classList.remove('text-zinc-400');
      } else {
        pill.classList.remove('bg-white', 'text-black');
        pill.classList.add('text-zinc-400');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('w-8', 'bg-white');
        dot.classList.remove('w-2', 'bg-zinc-800');
      } else {
        dot.classList.remove('w-8', 'bg-white');
        dot.classList.add('w-2', 'bg-zinc-800');
      }
    });
  }

  function scrollToSlide(index: number) {
    if (!slider || slides.length === 0) return;
    const total = slides.length;
    const target = (index + total) % total;
    const slideEl = slides[target] as HTMLElement;
    slider.scrollTo({
      left: slideEl.offsetLeft,
      behavior: 'smooth'
    });
    updateIndicators(target);
  }

  prevBtn?.addEventListener('click', () => scrollToSlide(currentIndex - 1));
  nextBtn?.addEventListener('click', () => scrollToSlide(currentIndex + 1));

  document.querySelectorAll('[data-slide-to]').forEach((el) => {
    el.addEventListener('click', () => {
      const idx = Number(el.getAttribute('data-slide-to'));
      scrollToSlide(idx);
    });
  });

  slider?.addEventListener('scroll', () => {
    if (!slider) return;
    const slideWidth = slider.clientWidth;
    if (slideWidth > 0) {
      const newIndex = Math.round(slider.scrollLeft / slideWidth);
      if (newIndex !== currentIndex) {
        updateIndicators(newIndex);
      }
    }
  });
</script>
