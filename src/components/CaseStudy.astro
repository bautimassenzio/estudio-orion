---
const views = [
  {
    id: "view-1",
    label: "01. Tienda & Catálogo",
    caption: "Portada comercial y catálogo dinámico de colecciones con acceso a venta minorista y mayorista.",
    img: "/tango1.jpg",
    alt: "Por Más Tango - Catálogo e Inicio"
  },
  {
    id: "view-2",
    label: "02. Producto & Carrito",
    caption: "Ficha de producto con selección de talles (S a XXL), detalle de prenda y carrito en tiempo real.",
    img: "/tango2.jpg",
    alt: "Por Más Tango - Ficha de Producto"
  },
  {
    id: "view-3",
    label: "03. Panel de Administración",
    caption: "Sistema interno a medida: métricas de facturación, control de stock en taller, pedidos mayoristas y despachos.",
    img: "/tango3.jpeg",
    alt: "Por Más Tango - Panel de Administración"
  }
];
---

<section id="proyectos" class="py-24 relative border-t border-zinc-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-zinc-400 font-semibold">Caso de Éxito Real</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Desarrollos en producción que gestionan ventas reales.
      </p>
      <p class="mt-4 text-base sm:text-lg text-zinc-400">
        Conocé por dentro cómo diseñamos tanto la vidriera comercial para el comprador como el software administrativo para el dueño del negocio.
      </p>
    </div>

    <!-- Contenedor Principal del Caso de Estudio -->
    <div class="rounded-3xl bg-zinc-950 border border-zinc-900 p-6 sm:p-10 lg:p-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Columna Izquierda: Información del Proyecto -->
        <div class="lg:col-span-5 space-y-6">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white text-black">
              E-commerce + Software
            </span>
            <span class="px-3 py-1 rounded-full text-[11px] font-medium bg-zinc-900 text-zinc-300 border border-zinc-800">
              Indumentaria Urbana
            </span>
          </div>

          <div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              Por Más Tango
            </h3>
            <p class="text-xs text-zinc-500 font-mono mt-1">
              por-mastango.com.ar
            </p>
          </div>

          <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
            Plataforma integral de comercio electrónico desarrollada a medida. Combina una tienda online rápida y minimalista para los clientes con un <strong class="text-white font-semibold">panel de control privado</strong> para administrar toda la operación de la marca.
          </p>

          <div class="border-t border-zinc-900 pt-5">
            <span class="text-xs font-semibold uppercase tracking-wider text-zinc-300 block mb-3.5">
              Soluciones implementadas:
            </span>
            <ul class="space-y-2.5 text-sm text-zinc-300">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Catálogo dinámico con selector de talles y carrito de compras.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Dashboard administrativo con métricas de facturación mensual.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Control de stock en taller, alta de productos y categorías.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-white shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Gestión de pedidos pendientes, despachos y canal mayorista.</span>
              </li>
            </ul>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-3">
            <a
              href="https://por-mastango.com.ar"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl text-sm font-semibold text-black bg-white hover:bg-zinc-200 transition text-center inline-flex items-center justify-center gap-2"
            >
              <span>Visitar sitio web</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
            <a
              href="#contacto"
              class="px-6 py-3 rounded-xl text-sm font-semibold text-white bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 transition text-center"
            >
              Cotizar un proyecto así
            </a>
          </div>
        </div>

        <!-- Columna Derecha: Galería Interactiva (Tienda + Producto + Dashboard) -->
        <div class="lg:col-span-7">
          <!-- Botones Selectores de Vista -->
          <div class="flex flex-wrap gap-2 mb-4" id="tango-tabs">
            {views.map((v, index) => (
              <button
                type="button"
                data-target={v.id}
                class={`tango-tab px-4 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer border ${
                  index === 0
                    ? 'bg-white text-black border-white'
                    : 'bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-white hover:border-zinc-700'
                }`}
              >
                {v.label}
              </button>
            ))}
          </div>

          <!-- Marco estilo navegador con las capturas -->
          <div class="rounded-2xl overflow-hidden border border-zinc-800 bg-zinc-900 shadow-2xl">
            <!-- Barra superior del navegador simulado -->
            <div class="bg-zinc-900 px-4 py-2.5 border-b border-zinc-800 flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-zinc-700"></span>
              </div>
              <span class="text-[11px] font-mono text-zinc-400">por-mastango.com.ar</span>
              <div class="w-10"></div>
            </div>

            <!-- Imágenes -->
            {views.map((v, index) => (
              <div
                id={v.id}
                class={`tango-panel ${index === 0 ? 'block' : 'hidden'}`}
              >
                <div class="aspect-[16/10] w-full bg-zinc-950 overflow-hidden">
                  <img
                    src={v.img}
                    alt={v.alt}
                    class="w-full h-full object-cover object-top"
                    loading="lazy"
                  />
                </div>
                <div class="p-4 bg-zinc-950 border-t border-zinc-900 flex items-center justify-between gap-4">
                  <p class="text-xs text-zinc-400">
                    {v.caption}
                  </p>
                  <span class="text-[11px] font-mono text-zinc-500 shrink-0">
                    Vista {index + 1}/3
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.tango-tab');
  const panels = document.querySelectorAll('.tango-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-target');

      // Actualizar estilo de pestañas
      tabs.forEach((t) => {
        t.classList.remove('bg-white', 'text-black', 'border-white');
        t.classList.add('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
      });
      tab.classList.remove('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
      tab.classList.add('bg-white', 'text-black', 'border-white');

      // Mostrar panel correspondiente
      panels.forEach((panel) => {
        if (panel.id === targetId) {
          panel.classList.remove('hidden');
          panel.classList.add('block');
        } else {
          panel.classList.remove('block');
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>

