---
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center text-center">

      <!-- Badge de Estado -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-cyan-500/30 bg-cyan-950/40 backdrop-blur-md mb-8">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span class="text-xs font-semibold text-cyan-200">
          Consultoría Tecnológica & Desarrollo a Medida
        </span>
      </div>

      <!-- Título Principal -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight max-w-5xl leading-[1.15]">
        Impulsamos tu negocio con <br class="hidden sm:inline" />
        <span class="text-gradient">soluciones informáticas</span> que dan resultados.
      </h1>

      <!-- Bajada / Subtítulo orientada al cliente -->
      <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">
        Desde <strong class="text-white font-semibold">landing pages de alto impacto</strong> para captar clientes, hasta <strong class="text-white font-semibold">sistemas a medida y automatizaciones</strong> que te ahorran horas de trabajo operativo. Nos ocupamos de toda la tecnología para que vos te enfoques en crecer.
      </p>

      <!-- Botones de Acción -->
      <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
        <a
          href="#contacto"
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:opacity-95 shadow-xl shadow-cyan-500/25 transition-all duration-300 hover:scale-105 text-center"
        >
          Pedir asesoramiento gratuito
        </a>
        <a
          href="#servicios"
          class="w-full sm:w-auto px-8 py-4 rounded-xl text-base font-semibold text-gray-300 bg-gray-900/80 hover:bg-gray-850 border border-gray-800 hover:border-gray-700 transition-all text-center flex items-center justify-center gap-2 group"
        >
          <span>Explorar soluciones</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
      </div>

      <!-- Tarjetas de Métricas / Garantías para el cliente -->
      <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 w-full max-w-4xl">
        <div class="p-5 rounded-2xl bg-gray-900/50 border border-gray-800/80 backdrop-blur-sm text-center">
          <div class="text-3xl font-extrabold text-cyan-400">100%</div>
          <div class="text-xs text-gray-400 mt-1 font-medium">Adaptado a tu negocio</div>
        </div>
        <div class="p-5 rounded-2xl bg-gray-900/50 border border-gray-800/80 backdrop-blur-sm text-center">
          <div class="text-3xl font-extrabold text-indigo-400">&lt; 24hs</div>
          <div class="text-xs text-gray-400 mt-1 font-medium">Tiempo de respuesta</div>
        </div>
        <div class="p-5 rounded-2xl bg-gray-900/50 border border-gray-800/80 backdrop-blur-sm text-center">
          <div class="text-3xl font-extrabold text-purple-400">Cero</div>
          <div class="text-xs text-gray-400 mt-1 font-medium">Complicaciones técnicas</div>
        </div>
        <div class="p-5 rounded-2xl bg-gray-900/50 border border-gray-800/80 backdrop-blur-sm text-center">
          <div class="text-3xl font-extrabold text-emerald-400">Enfoque</div>
          <div class="text-xs text-gray-400 mt-1 font-medium">En ventas y eficiencia</div>
        </div>
      </div>

    </div>
  </div>
</section>
