---
const steps = [
  {
    number: "01",
    title: "Diagnóstico & Estructura",
    description: "Analizamos tu negocio, tus clientes objetivo y tu propuesta de valor. Definimos los textos estratégicos (copywriting) y la jerarquía visual de la landing para maximizar el porcentaje de conversión."
  },
  {
    number: "02",
    title: "Diseño & Desarrollo Ágil",
    description: "Programamos el sitio con Astro y Tailwind CSS v4, sin plantillas genéricas. Te damos acceso a una vista previa en vivo para que puedas probar la experiencia y sugerir ajustes antes del despliegue final."
  },
  {
    number: "03",
    title: "Auditoría 100/100 & Lanzamiento",
    description: "Ejecutamos pruebas de velocidad en Google PageSpeed, configuramos tu dominio .com.ar en la red de Cloudflare con SSL gratis, y dejamos conectados los formularios a tu WhatsApp o correo."
  }
];
---

<section id="proceso" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-bold">Cómo Trabajamos</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        De la idea al lanzamiento en <span class="text-gradient">3 pasos claros</span>.
      </p>
      <p class="mt-4 text-base sm:text-lg text-gray-400">
        Un proceso transparente, sin demoras innecesarias y enfocado en que tu web empiece a generar resultados cuanto antes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((step, idx) => (
        <div class="relative p-8 rounded-3xl bg-gray-900/40 border border-gray-800 flex flex-col justify-between">
          <div>
            <div class="text-4xl sm:text-5xl font-black text-gray-800 mb-6 font-mono group-hover:text-cyan-500/30 transition-colors">
              {step.number}
            </div>
            <h3 class="text-xl font-bold text-white mb-3">
              {step.title}
            </h3>
            <p class="text-sm text-gray-400 leading-relaxed">
              {step.description}
            </p>
          </div>

          <div class="mt-8 flex items-center gap-2 text-xs font-semibold text-cyan-400">
            <span>Fase {idx + 1}</span>
            <div class="h-[1px] flex-1 bg-gradient-to-r from-cyan-500/40 to-transparent"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

