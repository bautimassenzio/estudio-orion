---
const steps = [
  {
    number: "01",
    title: "Diagnóstico y Relevamiento",
    description: "Analizamos en profundidad tu modelo de negocio, tu público y los objetivos del proyecto. Definimos la estructura exacta y el alcance sin presupuestos confusos."
  },
  {
    number: "02",
    title: "Diseño y Programación",
    description: "Construimos tu sitio o software con código moderno y limpio. Te damos acceso a una versión previa funcional para que puedas probar la experiencia y validar detalles."
  },
  {
    number: "03",
    title: "Puesta en Marcha y Entrega",
    description: "Configuramos tu dominio propio (.com.ar o .com), verificamos la velocidad y seguridad, y dejamos conectadas las automatizaciones o vías de contacto."
  }
];
---

<section id="proceso" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-zinc-400 font-semibold">Método de Trabajo</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Procesos claros, entregas a tiempo.
      </p>
      <p class="mt-4 text-base sm:text-lg text-zinc-400">
        Un flujo de trabajo ordenado y sin sorpresas para que tengas visibilidad total del avance de tu proyecto.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
      {steps.map((step, idx) => (
        <div class="p-8 rounded-2xl bg-zinc-950 border border-zinc-900 flex flex-col justify-between">
          <div>
            <div class="text-3xl font-mono font-bold text-zinc-600 mb-6">
              {step.number}
            </div>
            <h3 class="text-lg font-bold text-white mb-2.5">
              {step.title}
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              {step.description}
            </p>
          </div>

          <div class="mt-8 flex items-center gap-2 text-xs font-semibold text-zinc-400">
            <span>Fase {idx + 1}</span>
            <div class="h-[1px] flex-1 bg-zinc-800"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
