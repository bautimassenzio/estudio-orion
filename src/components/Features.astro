---
const features = [
  {
    title: "Carga instantánea que no pierde ventas",
    description: "Cada segundo de demora en una web reduce drásticamente las consultas. Desarrollamos sitios ultralivianos que abren al instante, reteniendo a cada cliente que llega por publicidad o recomendación.",
    badge: "Más Clientes",
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Automatización de tareas repetitivas",
    description: "Conectamos tu sitio con WhatsApp, correos automáticos, planillas y pasarelas de pago. Menos tiempo respondiendo lo mismo y más tiempo cerrando ventas.",
    badge: "Ahorro de Tiempo",
    icon: `<svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`
  },
  {
    title: "Diseño que transmite autoridad",
    description: "La primera impresión define si un cliente te compra o duda de tu servicio. Diseñamos una presencia digital moderna, limpia y adaptada a cualquier pantalla que genera credibilidad inmediata.",
    badge: "Profesionalismo",
    icon: `<svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    title: "Sin costos ocultos ni sorpresas",
    description: "Te entregamos soluciones con infraestructura moderna que no te exige cuotas mensuales abusivas de mantenimiento ni servidores caros. Tu inversión es transparente.",
    badge: "Transparencia",
    icon: `<svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    title: "Preparado para crecer con vos",
    description: "¿Arrancás con una landing page y mañana necesitás un turnero, panel de clientes o sistema de presupuestos? Tu plataforma se expande a medida que tu negocio lo requiera.",
    badge: "Escalabilidad",
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"/></svg>`
  },
  {
    title: "Acompañamiento directo y sin tecnicismos",
    description: "No te hablamos en código ni te derivamos con bots. Tenés comunicación directa con quien lidera tu desarrollo para resolver dudas, hacer mejoras y asegurar el éxito del proyecto.",
    badge: "Soporte Cercano",
    icon: `<svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>`
  }
];
---

<section id="ventajas" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-bold">Por qué elegir Estudio Orión</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Tecnología puesta al servicio de <span class="text-gradient">tu crecimiento</span>.
      </p>
      <p class="mt-4 text-base sm:text-lg text-gray-400">
        No creamos páginas web solo para que se vean lindas. Desarrollamos herramientas que te ahorran tiempo operativo, atraen clientes y profesionalizan tu marca.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="relative group p-8 rounded-3xl bg-gray-900/40 border border-gray-800/80 hover:border-cyan-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-500/10">
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-2xl bg-gray-800/80 flex items-center justify-center group-hover:scale-110 transition-transform duration-300" set:html={feature.icon}></div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-gray-800/80 text-gray-300 border border-gray-700">
              {feature.badge}
            </span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors">
            {feature.title}
          </h3>
          <p class="text-sm text-gray-400 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
