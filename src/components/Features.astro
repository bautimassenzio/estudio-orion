---
const features = [
  {
    title: "Carga instantánea que no pierde ventas",
    description: "Cada segundo de espera en un sitio web reduce las consultas de tus clientes potenciales. Desarrollamos código optimizado que responde de inmediato en cualquier dispositivo o red móvil.",
    badge: "Rendimiento",
    icon: `<svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  },
  {
    title: "Automatización de tareas repetitivas",
    description: "Conectamos tu operativa con WhatsApp, cobros automáticos, bases de datos y notificaciones. Menos tareas manuales para vos y una respuesta inmediata para tus clientes.",
    badge: "Eficiencia",
    icon: `<svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`
  },
  {
    title: "Diseño sobrio que transmite solidez",
    description: "La presencia digital es la carta de presentación de tu empresa. Cuidamos cada detalle visual, tipográfico y de interacción para posicionar tu negocio como líder en su rubro.",
    badge: "Autoridad",
    icon: `<svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`
  },
  {
    title: "Sin cuotas sorpresa ni ataduras",
    description: "Te entregamos soluciones con infraestructura moderna sin costos mensuales abusivos de mantenimiento o servidores. La titularidad y el código de tu proyecto te pertenecen.",
    badge: "Transparencia",
    icon: `<svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    title: "Arquitectura escalable a futuro",
    description: "Podés comenzar con una landing page o catálogo y luego sumar paneles de administración, turneros o módulos a medida sin tener que rehacer el proyecto desde cero.",
    badge: "Escalabilidad",
    icon: `<svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 11l5-5m0 0l5 5m-5-5v12"/></svg>`
  },
  {
    title: "Trato directo y resolución ágil",
    description: "Sin intermediarios ni mesas de ayuda automatizadas. Hablás directamente con quien planifica y programa tu software, asegurando respuestas rápidas y soluciones concretas.",
    badge: "Atención Directa",
    icon: `<svg class="w-5 h-5 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>`
  }
];
---

<section id="ventajas" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-zinc-400 font-semibold">Por qué elegirnos</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Tecnología orientada a generar resultados.
      </p>
      <p class="mt-4 text-base sm:text-lg text-zinc-400">
        Combinamos ingeniería de software con diseño estratégico para que cada desarrollo resuelva un problema real de tu negocio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <div class="p-8 rounded-2xl bg-zinc-950 border border-zinc-900 hover:border-zinc-700 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-10 h-10 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center" set:html={feature.icon}></div>
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-zinc-900 text-zinc-400 border border-zinc-800">
                {feature.badge}
              </span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2.5">
              {feature.title}
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
