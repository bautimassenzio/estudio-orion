---
---

<section id="contacto" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl bg-gradient-to-b from-gray-900 via-gray-900/90 to-gray-950 border border-gray-800 p-8 sm:p-12 lg:p-16 shadow-2xl">
      
      <!-- Glow superior interno -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-48 bg-cyan-500/10 blur-3xl rounded-full pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <!-- Info Column -->
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-cyan-400">
            Hablemos de tu idea
          </span>
          <h2 class="mt-3 text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Contanos qué necesita tu negocio y lo <span class="text-gradient">hacemos realidad</span>.
          </h2>
          <p class="mt-4 text-base sm:text-lg text-gray-300 leading-relaxed">
            Ya sea una landing page para lanzar tu servicio o un software interno para ordenar tu operativa, te brindamos un diagnóstico honesto y un presupuesto claro sin vueltas.
          </p>

          <div class="mt-8 space-y-4">
            <div class="flex items-center gap-4 text-gray-300">
              <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs text-gray-400">Respuesta ágil</div>
                <div class="text-sm font-semibold text-white">Menos de 24 horas hábiles</div>
              </div>
            </div>

            <div class="flex items-center gap-4 text-gray-300">
              <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs text-gray-400">Email institucional</div>
                <div class="text-sm font-semibold text-white">contacto@estudioorion.com.ar</div>
              </div>
            </div>

            <div class="flex items-center gap-4 text-gray-300">
              <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <div class="text-xs text-gray-400">Ubicación y cobertura</div>
                <div class="text-sm font-semibold text-white">Buenos Aires, Argentina (Atención remota a todo el país)</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <div class="bg-gray-950/80 border border-gray-800 rounded-2xl p-6 sm:p-8">
          <form id="contact-form" class="space-y-4">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
                Nombre o Empresa *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ej. Martín Gómez / Distribuidora Sur"
                class="w-full px-4 py-3 rounded-xl bg-gray-900 border border-gray-800 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-colors text-sm"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
                Correo Electrónico *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="martin@empresa.com"
                class="w-full px-4 py-3 rounded-xl bg-gray-900 border border-gray-800 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-colors text-sm"
              />
            </div>

            <div>
              <label for="service-type" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
                Solución de interés
              </label>
              <select
                id="service-type"
                name="service-type"
                class="w-full px-4 py-3 rounded-xl bg-gray-900 border border-gray-800 text-white focus:outline-none focus:border-cyan-500 transition-colors text-sm"
              >
                <option value="Landing Page o Sitio Web">Landing Page o Sitio Web de Alto Impacto</option>
                <option value="Sistema de Gestión / Software a Medida">Sistema de Gestión / Software a Medida</option>
                <option value="Automatización de Procesos y Cobros">Automatización de Procesos y Cobros</option>
                <option value="Consultoría Informática General">Consultoría Informática General</option>
                <option value="Otra necesidad">Otra necesidad</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
                ¿Qué problema u objetivo querés resolver? *
              </label>
              <textarea
                id="message"
                name="message"
                rows="3"
                required
                placeholder="Ej. Necesito una landing para vender servicios de kinesiología y recibir los turnos por WhatsApp..."
                class="w-full px-4 py-3 rounded-xl bg-gray-900 border border-gray-800 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500 transition-colors text-sm resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 transition-all duration-300 shadow-lg shadow-cyan-500/25 flex items-center justify-center gap-2"
            >
              <span>Enviar consulta por WhatsApp</span>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.588 1.961.916 2.796.917 3.182 0 5.768-2.587 5.768-5.766 0-3.18-2.586-5.766-5.768-5.766zm9.969 5.766c0 5.514-4.486 10-10 10-1.802 0-3.488-.479-4.945-1.312l-5.055 1.374 1.374-5.055c-.833-1.457-1.374-3.143-1.374-4.945 0-5.514 4.486-10 10-10s10 4.486 10 10z"/>
              </svg>
            </button>

            <p class="text-[11px] text-gray-500 text-center">
              Respuesta en menos de 24 horas con una propuesta clara y sin compromiso.
            </p>
          </form>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    const service = (document.getElementById('service-type') as HTMLSelectElement).value;
    const message = (document.getElementById('message') as HTMLTextAreaElement).value;

    const text = `¡Hola Estudio Orión! 👋%0A%0AMi nombre/empresa es: *${encodeURIComponent(name)}*%0ACorreo de contacto: *${encodeURIComponent(email)}*%0AInterés en: *${encodeURIComponent(service)}*%0A%0AObjetivo o consulta:%0A${encodeURIComponent(message)}`;
    
    // Podés configurar tu número de WhatsApp real acá (código de país + número sin espacios ni símbolos)
    const phone = "5491112345678"; 
    window.open(`https://wa.me/${phone}?text=${text}`, '_blank');
  });
</script>
