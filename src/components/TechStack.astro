---
const technologies = [
  {
    name: "Astro 5",
    role: "Framework Web Moderno",
    desc: "Arquitectura de islas que genera HTML ultra ligero sin JS innecesario.",
    color: "from-orange-500/20 to-purple-500/20",
    border: "border-orange-500/40"
  },
  {
    name: "Tailwind CSS v4",
    role: "Motor de Estilos",
    desc: "Diseño moderno, limpio y responsive compilado directamente en el navegador.",
    color: "from-cyan-500/20 to-blue-500/20",
    border: "border-cyan-500/40"
  },
  {
    name: "TypeScript",
    role: "Tipado Estricto",
    desc: "Código limpio, mantenible y preparado para evolucionar a aplicaciones complejas.",
    color: "from-blue-500/20 to-indigo-500/20",
    border: "border-blue-500/40"
  },
  {
    name: "Cloudflare Edge",
    role: "Infraestructura Global",
    desc: "Distribución en 300+ ciudades del mundo, SSL automático y 0 costo mensual.",
    color: "from-amber-500/20 to-orange-500/20",
    border: "border-amber-500/40"
  }
];
---

<section id="tecnologias" class="py-24 bg-gray-950/80 border-t border-gray-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-cyan-400 font-bold">Tecnología de Vanguardia</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Construido sobre el stack más rápido del mundo.
      </p>
      <p class="mt-4 text-base sm:text-lg text-gray-400">
        No usamos plantillas sobrecargadas ni plugins vulnerables. Cada línea de código está optimizada para la velocidad, la seguridad y el posicionamiento.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {technologies.map((tech) => (
        <div class={`p-6 rounded-2xl bg-gradient-to-br ${tech.color} border ${tech.border} backdrop-blur-sm flex flex-col justify-between`}>
          <div>
            <div class="text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">
              {tech.role}
            </div>
            <h3 class="text-2xl font-black text-white mb-2">
              {tech.name}
            </h3>
            <p class="text-sm text-gray-300/90 leading-relaxed">
              {tech.desc}
            </p>
          </div>
          <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-white/80">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Rendimiento óptimo</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

