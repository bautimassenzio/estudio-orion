---
const demos = [
  {
    title: "Salud, Consultorios & Profesionales",
    style: "Diseño Claro & Luminoso",
    target: "Ideal para odontólogos, médicos, kinesiólogos, psicólogos, abogados y contadores.",
    features: ["Agenda de turnos a WhatsApp", "Sección de obras sociales", "Reseñas de pacientes"],
    url: "/demos/salud",
    accent: "bg-sky-500/10 text-sky-300 border-sky-500/30"
  },
  {
    title: "Comercios, Fitness & Estética",
    style: "Diseño Dinámico & Comercial",
    target: "Ideal para gimnasios, centros de estética, barberías, gastronomía y locales comerciales.",
    features: ["Cuadro de planes y precios", "Grilla de horarios y disciplinas", "Promoción de clase/turno de prueba"],
    url: "/demos/comercio",
    accent: "bg-amber-500/10 text-amber-300 border-amber-500/30"
  },
  {
    title: "Empresas, Construcción & Estudios",
    style: "Diseño Corporativo & Sobrio",
    target: "Ideal para constructoras, estudios de arquitectura, inmobiliarias, industrias y distribuidoras.",
    features: ["Galería de proyectos entregados", "Métricas de trayectoria", "Solicitud de cómputo y presupuesto"],
    url: "/demos/empresa",
    accent: "bg-orange-500/10 text-orange-300 border-orange-500/30"
  }
];
---

<section id="demos" class="py-24 bg-black border-b border-zinc-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs uppercase tracking-widest text-zinc-400 font-semibold">Modelos Interactivos</h2>
      <p class="mt-3 text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Explorá ejemplos reales según tu rubro.
      </p>
      <p class="mt-4 text-base sm:text-lg text-zinc-400">
        Hacé clic en cualquiera de nuestras demos en vivo para ver cómo estructuramos el diseño, la velocidad y los llamados a la acción en distintos sectores.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {demos.map((demo) => (
        <div class="p-8 rounded-2xl bg-zinc-950 border border-zinc-900 hover:border-zinc-700 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`text-[11px] font-semibold px-2.5 py-1 rounded-md border ${demo.accent}`}>
                {demo.style}
              </span>
              <span class="text-xs text-zinc-500 font-mono">Demo Interactiva</span>
            </div>

            <h3 class="text-xl font-bold text-white mb-2.5 group-hover:text-zinc-200 transition-colors">
              {demo.title}
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed mb-6">
              {demo.target}
            </p>

            <div class="border-t border-zinc-900 pt-5 mb-8">
              <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400 block mb-3">
                Incluye en la demo:
              </span>
              <ul class="space-y-2">
                {demo.features.map((feat) => (
                  <li class="flex items-center gap-2.5 text-xs text-zinc-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <a
            href={demo.url}
            class="w-full py-3 rounded-xl text-sm font-semibold text-black bg-white hover:bg-zinc-200 transition-all flex items-center justify-center gap-2"
          >
            <span>Ver demo en vivo</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

